# WebSocket session signing secret.
# Required in production. Generate with: openssl rand -hex 32
# In development, a fallback value is used automatically if this is unset.
SESSION_SECRET=

# Optional — defaults shown below
# PORT=3000
# HOSTNAME=localhost
# ALLOWED_ORIGINS=https://yourdomain.com

# Public base URL used for sitemap and robots.txt generation
# APP_URL=https://yourdomain.com
